# syntax=docker/dockerfile:1.28@sha256:bb22d9815c728170f72750f4e5b0d672e06176142e1d602c7e66c050100b7e5b
# Every service in one container (e-voice:full): STT on :5500 and TTS on :5600, run by docker/full.sh.
# TTS defaults to Qwen3 here: the only backend a container can install by itself (public weights).
# Build context is the repository root. Build steps are the Makefile's: `system`, `sherpa`, `dist`.

##### BASES #####
ARG CHEF=lukemathwalker/cargo-chef:latest-rust-1.99-slim-trixie@sha256:f122e3c240d1c05668b07179cf6fa07647db2a79a110f4bb8a91d75f90d5b8e4
ARG RUNTIME=debian:trixie-slim@sha256:f6b08b09a05725f9431502d3b5714f5c4576e82c1a84fa1debe0c24a7e0c3ec4

##### TOOLCHAIN #####
FROM ${CHEF} AS chef
WORKDIR /src
ENV CARGO_TARGET_DIR=/src/target
COPY Makefile ./
RUN apt-get update \
 && apt-get install -y --no-install-recommends make \
 && make system \
 && rm -rf /var/lib/apt/lists/*

##### RECIPE #####
FROM chef AS planner
COPY . .
RUN cargo chef prepare --recipe-path recipe.json

##### BUILD #####
FROM chef AS builder
ARG VERSION=""
ARG PACKAGES="--package e-voice-stt --package e-voice-tts"
ARG BINS="e-voice e-voice-tts"
COPY Cargo.lock ./
COPY evoice/core/ops/sherpa.sh evoice/core/ops/sherpa.sh
RUN make sherpa
COPY .cargo .cargo
COPY --from=planner /src/recipe.json recipe.json
RUN cargo chef cook --release --locked ${PACKAGES} --recipe-path recipe.json
COPY . .
RUN E_VOICE_VERSION="${VERSION}" make dist PACKAGES="${PACKAGES}" BINS="${BINS}" DIST=/out

##### RUNTIME #####
# No make or toolchain here by design: the runtime only needs certificates and an init.
FROM ${RUNTIME}
RUN apt-get update \
 && apt-get install -y --no-install-recommends ca-certificates espeak-ng tini \
 && rm -rf /var/lib/apt/lists/* \
 && useradd --create-home --uid 10001 evoice \
 && mkdir -p /data/stt /data/tts && chown -R evoice:evoice /data
COPY --from=builder /out/ /app/
COPY evoice/stt/models.toml /app/stt/models.toml
COPY evoice/tts/models.toml /app/tts/models.toml
COPY --chmod=755 docker/full.sh /app/bin/e-voice-full
ENV PATH=/app/bin:$PATH \
    EVOICE_STT__OPS__DATA=/data/stt \
    EVOICE_STT__OPS__MANIFEST=/app/stt/models.toml \
    EVOICE_TTS__OPS__DATA=/data/tts \
    EVOICE_TTS__OPS__MANIFEST=/app/tts/models.toml \
    EVOICE_TTS__SYNTH__BACKEND=qwen3 \
    EVOICE_TTS__SYNTH__WORKERS=2 \
    EVOICE_TTS__SYNTH__THREADS=4 \
    EVOICE_SERVER__LOG__FORMAT=json
WORKDIR /app
USER evoice
VOLUME ["/data/stt", "/data/tts"]
EXPOSE 5500 5600
HEALTHCHECK --interval=15s --timeout=3s --start-period=180s --retries=3 \
  CMD ["bash", "-c", "for port in 5500 5600; do exec 3<>/dev/tcp/127.0.0.1/$port && printf 'GET /health HTTP/1.0\\r\\n\\r\\n' >&3 && grep -q '\"ok\"' <&3 || exit 1; exec 3>&-; done"]
ENTRYPOINT ["tini", "-g", "--", "e-voice-full"]
CMD ["serve"]
